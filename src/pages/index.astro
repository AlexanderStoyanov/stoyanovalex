---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

function formatDate(date: Date): string {
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
}
---

<Layout title="Alex Stoyanov">
	<section class="mb-12">
		<h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-3">Hey, I'm Alex</h1>
		<p class="text-sand-700 text-base sm:text-lg leading-relaxed">
			Welcome to my corner of the internet. I write about software,
			technology, and things I find interesting.
		</p>
	</section>

	{
		posts.length > 0 && (
			<section>
				<h2 class="text-xl font-semibold tracking-tight mb-4">Recent posts</h2>
				<ul class="space-y-0">
					{posts.map((post) => (
						<li class="flex justify-between items-baseline gap-4 py-3 border-b border-sand-200 last:border-b-0">
							<a href={`/blog/${post.id}`} class="text-sand-500 hover:text-sand-600 no-underline hover:underline">
								{post.data.title}
							</a>
							<time datetime={post.data.pubDate.toISOString()} class="text-sand-700 text-sm whitespace-nowrap">
								{formatDate(post.data.pubDate)}
							</time>
						</li>
					))}
				</ul>
				<a href="/blog" class="inline-block mt-4 text-[0.95rem] text-sand-500 no-underline hover:text-sand-600 hover:underline">
					All posts &rarr;
				</a>
			</section>
		)
	}
</Layout>
