---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date): string {
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
		timeZone: "UTC",
	});
}
---

<Layout title="Blog — Alex Stoyanov" description="Blog posts by Alex Stoyanov.">
	<h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-6">Blog</h1>

	{
		posts.length === 0 ? (
			<p class="text-sand-700">No posts yet. Check back soon.</p>
		) : (
			<ul class="divide-y divide-sand-200">
				{posts.map((post) => (
					<li class="py-5 first:pt-0 last:pb-0">
						<a href={`/blog/${post.id}`} class="block no-underline group">
							<span class="font-medium text-sand-500 group-hover:underline">
								{post.data.title}
							</span>
							<span class="block text-sand-700 text-sm mt-1">
								{post.data.description}
							</span>
						</a>
						<time datetime={post.data.pubDate.toISOString()} class="text-sand-700 text-sm mt-1 block">
							{formatDate(post.data.pubDate)}
						</time>
					</li>
				))}
			</ul>
		)
	}
</Layout>
