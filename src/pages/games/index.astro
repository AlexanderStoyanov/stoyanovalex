---
import Layout from "../../layouts/Layout.astro";
import GameCard from "../../components/GameCard.astro";
import { games } from "../../data/games";
---

<Layout title="Games — Alex Stoyanov" description="Browser games made by Alex Stoyanov.">
	<h1 class="text-2xl sm:text-3xl font-bold tracking-tight mb-2">Games</h1>
	<p class="text-sand-700 mb-8">Little games I've made. They all run right in your browser.</p>

	<ul class:list={["grid gap-6", games.length > 1 && "sm:grid-cols-2"]}>
		{
			games.map((game) => (
				<li>
					<GameCard game={game} />
				</li>
			))
		}
	</ul>
</Layout>
