---
import { getPublishedPosts } from "../lib/posts";

const pathname = Astro.url.pathname;
const hasPosts = (await getPublishedPosts()).length > 0;

const links = [
	{ href: "/games", label: "Games" },
	...(hasPosts ? [{ href: "/blog", label: "Blog" }] : []),
];
---

<header class="border-b border-sand-200">
	<nav class="max-w-2xl mx-auto px-5 sm:px-6 py-5 flex justify-between items-center">
		<a href="/" class="font-semibold text-sand-900 no-underline hover:text-sand-500 transition-colors">
			Alex Stoyanov
		</a>
		<div class="flex gap-6">
			{
				links.map(({ href, label }) => (
					<a
						href={href}
						class:list={[
							"no-underline text-[0.95rem] transition-colors",
							pathname.startsWith(href) ? "text-sand-900" : "text-sand-700 hover:text-sand-900",
						]}
					>
						{label}
					</a>
				))
			}
		</div>
	</nav>
</header>
