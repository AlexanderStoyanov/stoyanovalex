---
import type { Game } from "../data/games";

interface Props {
	game: Game;
}

const { game } = Astro.props;
const host = new URL(game.url).host;
---

<a
	href={game.url}
	class="group block no-underline rounded-2xl border border-sand-200 bg-white/60 overflow-hidden shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-sand-900/10 hover:border-sand-400 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sand-500"
>
	<div class="relative aspect-[16/10] overflow-hidden" style={{ backgroundColor: game.color }}>
		<img
			src={game.cover}
			alt={`${game.title} cover art`}
			width="1600"
			height="1000"
			loading="lazy"
			decoding="async"
			class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
		/>
		<span
			class="absolute bottom-3 right-3 rounded-full bg-black/55 px-3 py-1 text-xs font-medium text-white backdrop-blur-sm opacity-0 translate-y-1 transition duration-300 group-hover:opacity-100 group-hover:translate-y-0 group-focus-visible:opacity-100 group-focus-visible:translate-y-0"
		>
			Play now &rarr;
		</span>
	</div>
	<div class="p-5">
		<div class="flex items-baseline justify-between gap-4">
			<h2 class="text-lg font-semibold tracking-tight text-sand-900">{game.title}</h2>
			<span class="text-xs text-sand-700 whitespace-nowrap">{host}</span>
		</div>
		<p class="text-sand-700 text-[0.95rem] leading-relaxed mt-1">{game.description}</p>
		<ul class="flex flex-wrap gap-2 mt-4">
			{game.tags.map((tag) => <li class="rounded-full bg-sand-100 px-2.5 py-0.5 text-xs text-sand-700">{tag}</li>)}
		</ul>
	</div>
</a>
